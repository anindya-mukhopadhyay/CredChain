# ==============================================================================
# CredChain — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real secrets, private keys, or credentials to source control!

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development                    # development | test | production
APP_BASE_URL=http://localhost:3000      # Public frontend web application URL

# ------------------------------------------------------------------------------
# 2. SERVER ONLY — BACKEND CONFIGURATION (DO NOT EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
DATABASE_URL=postgres://credchain:credchain@localhost:5432/credchain
JWT_SECRET=replace-with-a-cryptographically-secure-random-32-character-secret-in-production

# Demo account auto-seeding (Set to false or leave unset in production)
ENABLE_DEMO_SEED=true

# ------------------------------------------------------------------------------
# 3. SERVER ONLY — BLOCKCHAIN REGISTRY & WALLET (DO NOT EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CREDENTIAL_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 4. SERVER ONLY — OFF-CHAIN STORAGE
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_ROOT=./storage

# ------------------------------------------------------------------------------
# 5. PUBLIC CLIENT VARIABLES (SAFE FOR NEXT.JS BUNDLE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
