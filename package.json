{
  "name": "credchain",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-backed credential verification MVP with off-chain sensitive data and on-chain credential proofs.",
  "workspaces": [
    "backend",
    "blockchain",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}

